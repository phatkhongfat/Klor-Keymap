#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 300   // mousescroll SPEED

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <3000>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <1000>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 3 seconds or longer.
};

&mt { flavor = "tap-preferred"; };

&lt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

&sk {
    quick-release;
    lazy;
};

/ {
    behaviors {
        Scroll_D_U: Scroll_D_U {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_D_U";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        TD01: TD01 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD01";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp PERIOD>;
        };

        Scroll_U_D: Scroll_U_D {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_U_D";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        Scroll_LR: Scroll_LR {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_LR";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };

        Scroll_RL: Scroll_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_RL";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;

            tap-ms = <20>;
        };

        mouse_DU: mouse_DU {
            compatible = "zmk,behavior-sensor-rotate";
            label = "MOUSE_DU";
            #sensor-binding-cells = <0>;
            bindings = <&mmv MOVE_DOWN>, <&mmv MOVE_UP>;
        };

        mouse_RL: mouse_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "MOUSE_RL";
            #sensor-binding-cells = <0>;
            bindings = <&mmv MOVE_RIGHT>, <&mmv MOVE_LEFT>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Left_Parenthesis {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <1 2>;
        };

        Right_Parenthesis {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <7 8>;
        };

        Left_Brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <12 13>;
        };

        Right_Brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <19 18>;
        };

        Right_Bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <30 31>;
        };

        Left_Bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <24 25>;
        };

        Escape {
            bindings = <&kp ESC>;
            key-positions = <10 0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
           &kp Q   &kp W       &kp E      &kp R         &kp T        &kp Y            &kp U      &kp I          &kp O       &kp P
&kp TAB    &kp A   &kp S       &kp D      &kp F         &kp G        &kp H            &kp J      &kp K          &kp L       &kp SEMI  &kp SINGLE_QUOTE
&kp LSHFT  &kp Z   &kp X       &kp C      &kp V         &kp B        &kp N            &kp M      &kp COMMA      &kp DOT     &kp FSLH  &kp BACKSLASH
                   &kp K_MUTE  &kp LCTRL  &kp LEFT_ALT  &lt 1 SPACE  &lt 2 RIGHT_GUI  &kp ENTER  &kp BACKSPACE  &kp INSERT
&kp LEFT   &kp UP  &kp ENTER   &kp DOWN   &kp RIGHT                                   &kp LEFT   &kp DOWN       &kp RET     &kp UP    &kp RIGHT
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };

        lower_layer {
            display-name = "Lower Layer";
            bindings = <
           &trans        &kp HOME      &kp UP        &kp END          &trans  &trans  &kp N7  &kp N8  &kp N9  &kp PLUS
&trans     &trans        &kp LEFT      &kp DOWN      &kp RIGHT        &trans  &trans  &kp N4  &kp N5  &kp N6  &kp MINUS     &kp EQUAL
&trans     &trans        &kp PG_UP     &kp CLCK      &kp PAGE_DOWN    &trans  &kp N0  &kp N1  &kp N2  &kp N3  &kp ASTERISK  &trans
                         &trans        &trans        &trans           &trans  &mo 3   &trans  &trans  &trans
&kp LG(L)  &kp C_VOL_UP  &kp LEFT_GUI  &kp C_VOL_DN  &kp PRINTSCREEN                  &trans  &trans  &trans  &trans        &trans
            >;

            sensor-bindings =
                <&inc_dec_kp DOWN UP_ARROW>,
                <&inc_dec_kp LA(LS(TAB)) LA(TAB)>;
        };

        raise_layer {
            display-name = "Raise Layer";
            bindings = <
        &kp EXCLAMATION  &kp AT_SIGN       &kp POUND          &kp DOLLAR        &kp TILDE              &trans  &trans  &trans  &trans  &trans
&trans  &kp UNDERSCORE   &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp EQUAL         &kp LEFT_PARENTHESIS   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp BACKSLASH    &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SINGLE_QUOTE  &kp RIGHT_PARENTHESIS  &trans  &trans  &trans  &trans  &trans  &trans
                         &trans            &trans             &trans            &trans                 &trans  &trans  &trans  &trans
&trans  &trans           &trans            &trans             &trans                                           &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };

        FN {
            bindings = <
        &kp F1   &kp F2   &kp F3  &kp F4  &kp F5   &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3   &bt BT_DISC 4
&trans  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10  &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3    &bt BT_SEL 4   &trans
&trans  &kp F11  &kp F12  &trans  &trans  &trans   &bt BT_CLR     &bt BT_NXT     &bt BT_PRV     &bt BT_CLR_ALL  &trans         &trans
                 &trans   &trans  &trans  &trans   &trans         &trans         &trans         &trans
&trans  &trans   &trans   &trans  &trans                          &trans         &trans         &trans          &trans         &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>,
                <&inc_dec_kp C_BRIGHTNESS_MAXIMUM C_BRIGHTNESS_MAXIMUM>;
        };

        mouse {
            bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans          &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans          &trans    &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans          &trans    &trans        &trans
                &trans  &trans  &trans  &trans  &trans  &trans          &trans          &trans
&trans  &trans  &trans  &trans  &trans                  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mkp MB1  &mmv MOVE_UP  &mmv MOVE_RIGHT
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };

        layer_5 {
            bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };

        layer_6 {
            bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        mouse_lower {
            if-layers = <1>;
            then-layer = <4>;
        };

        mouse_raise {
            if-layers = <2>;
            then-layer = <4>;
        };
    };
};
